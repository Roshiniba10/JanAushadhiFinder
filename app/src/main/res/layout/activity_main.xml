<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft">

    <!-- Professional Gradient Header -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Navigation Header -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Top Action Area -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnViewFavorites"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="View Favorites"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/solutionHeaderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medicine Finder"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Smart Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/solutionHeaderText">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/medicineSearchView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:iconifiedByDefault="false"
            app:queryHint="Search disease, medicine or symptom..."
            app:queryBackground="@android:color/transparent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/diseaseNameSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Showing results..."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Results List Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/diseaseNameSubtitle"
        app:layout_constraintBottom_toTopOf="@id/finishBtn">

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishBtn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="FINISH SESSION"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="16dp"
        android:backgroundTint="@color/secondary"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>