<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg">

    <!-- Decorative Top Design -->
    <View
        android:id="@+id/topDecor"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/circle_decoration"
        android:alpha="0.2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp" />

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnViewFavorites"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorites"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Logo Card - Restored to Circle with improved alignment -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoCard"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:cardCornerRadius="90dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/white"
        app:strokeWidth="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/brandingGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginTop="60dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:padding="16dp"
            android:contentDescription="Jan Aushadhi Logo" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Branding Text -->
    <LinearLayout
        android:id="@+id/brandingGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/logoCard"
        app:layout_constraintBottom_toTopOf="@+id/insightCard">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jan Aushadhi"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/appSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINDER"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:letterSpacing="0.2" />
    </LinearLayout>

    <!-- Health Insight Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/insightCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/brandingGroup"
        app:layout_constraintBottom_toTopOf="@id/loginBtn"
        app:layout_constraintVertical_bias="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/primary_light">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S HEALTH TIP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/healthTipText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Loading wellness insight..."
                android:textSize="15sp"
                android:textColor="@color/text_body"
                android:lineSpacingExtra="4dp"
                android:textStyle="italic" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- GET STARTED Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="GET STARTED"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="48dp"
        app:cornerRadius="36dp"
        android:backgroundTint="@color/secondary"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>